#!/command/with-contenv bash
# shellcheck shell=bash
set -e

. /opt/lib/lib.sh

register () {
  local try max_attempts
  local registration_token="$1"
  local runner_name="$2"
  local config_arg="$3"
  local extra_args="$4"

  RUNNER_STATE_FILE=${RUNNER_STATE_FILE:-'.runner'}
  if [[ -s "$RUNNER_STATE_FILE" ]]; then
    return 0
  fi

  try=0
  success=0
  max_attempts=${GITEA_MAX_REG_ATTEMPTS:-10}

  # The point of this loop is to make it simple, when running both runner and gitea in docker,
  # for the runner to wait a moment for gitea to become available before erroring out.  Within
  # the context of a single docker-compose, something similar could be done via healthchecks, but
  # this is more flexible.
  while [[ $success -eq 0 ]] && [[ $try -lt $max_attempts ]]; do
    try=$(( $try + 1 ))
    set +e
    s6-setuidgid abc \
      timeout 15 \
        gitea-runner register \
          --instance "$(get_env GITEA_INSTANCE_URL)" \
          --token    "${registration_token}" \
          --name     "${runner_name:-`hostname`}" \
          ${config} ${extra_args} --no-interactive 2>&1 | tee /tmp/reg.log
    set -e

    if grep -q 'Runner registered successfully' /tmp/reg.log; then
      return 0
    else
      info "Waiting to retry (attempt ${try}/${max_attempts}) ..."
      sleep 5
    fi
  done

  info "Registration failed after ${max_attempts} attempts, giving up"
  return 1
}

main () {
  local instance
  local instances

  if [ -z "$(get_env GITEA_INSTANCE_URL)" ]; then
    die "No GITEA_INSTANCE_URL variables are set. Exiting"
  fi

  instances=$(get_gitea_runner_instance_count)

  if [ ${instances} = 0 ]; then
    die "No GITEA_RUNNER_REGISTRATION_TOKEN variables are set. Exiting"
  fi

  info "Register ${instances} runners on $(get_env GITEA_INSTANCE_URL)"
  for instance in $(seq 0 $((${instances} - 1)) ); do
    local config_file
    if [ $instance = 0 ]; then
      pushd /config > /dev/null
      config_file="/config/config.yaml"
    else
      s6-setuidgid abc mkdir -p "/config/instance_${instance}"
      pushd "/config/instance_${instance}" > /dev/null
      config_file="/config/instance_${instance}/config.yaml"
    fi

    local config_arg label_args
    local extra_args run_args

    config_arg="--config \"${config_file}\""
    if [ -n "$(get_env "GITEA_RUNNER_LABELS" $instance)" ]; then
      label_args="--labels $(get_env "GITEA_RUNNER_LABELS" $instance)"
    fi
    extra_args="${label_args}"
    if [ -n "$(get_env "GITEA_RUNNER_EPHEMERAL" $instance)" ]; then
      extra_args="${extra_args} --ephemeral"
    fi
    # Also pass the labels to the daemon, so that an already registered runner
    # picks up changes to GITEA_RUNNER_LABELS instead of keeping the labels it
    # was first registered with.
    run_args="${label_args}"
    if [ -n "$(get_env "GITEA_RUNNER_ONCE" $instance)" ]; then
      run_args="${run_args} --once"
    fi

    register "$(get_env "GITEA_RUNNER_REGISTRATION_TOKEN" ${instance})" "$(get_env "GITEA_RUNNER_NAME" ${instance})" "${config_arg}" "${extra_args}" \
      || die "Registration for runner ${instance} failed. Exiting"
    info "Registration for runner ${instance} succeeded"

    popd > /dev/null
  done
}

main